# JASS - Zabbix API Connection Settings
ZABBIX_URL=http://zabbix.corp.local/api_jsonrpc.php

# Option 1 (Recommended): API Token (Zabbix 6.0+)
ZABBIX_API_TOKEN=your_zabbix_api_token_here

# Option 2 (Fallback): Legacy user.login authentication
# ZABBIX_USER=Admin
# ZABBIX_PASSWORD=zabbix

# Network and execution settings
ZABBIX_TIMEOUT=15
ZABBIX_VERIFY_SSL=true
JASS_OUTPUT_DIR=./analysis_reports

