# JASS - Konfiguracja połączenia z Zabbix API
ZABBIX_URL=http://zabbix.corp.local/api_jsonrpc.php

# Opcja 1 (Zalecana): API Token (Zabbix 6.0+)
ZABBIX_API_TOKEN=your_zabbix_api_token_here

# Opcja 2 (Fallback): Tradycyjne logowanie user.login
# ZABBIX_USER=Admin
# ZABBIX_PASSWORD=zabbix

# Parametry sieciowe i wykonawcze
ZABBIX_TIMEOUT=15
ZABBIX_VERIFY_SSL=true
JASS_OUTPUT_DIR=./analysis_reports
